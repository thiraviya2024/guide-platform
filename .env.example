APP_NAME=LipidAI
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development
ENABLE_DEMO_AUTH=false

DATABASE_URL=postgresql://user:password@localhost:5432/lipidai

# Firebase server-side configuration. Render uses these three values. Never
# commit a real service-account JSON/private key. Use literal \n in the key;
# the backend converts escaped newlines back to PEM newlines.
FIREBASE_PROJECT_ID=life-saver-93cc0
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Legacy local-development alternatives:
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternative to JSON for hosts that do not preserve multiline values:
FIREBASE_SERVICE_ACCOUNT_BASE64=

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
DEFAULT_LLM_PROVIDER=mistral

ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
