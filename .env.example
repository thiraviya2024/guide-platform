APP_NAME=LipidAI
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development
ENABLE_DEMO_AUTH=false

DATABASE_URL=postgresql://user:password@localhost:5432/lipidai

# Firebase server-side configuration. Set ONE service-account value in the
# deployment environment; never commit a real service-account JSON/private key.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternative to JSON for hosts that do not preserve multiline values:
FIREBASE_SERVICE_ACCOUNT_BASE64=

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
DEFAULT_LLM_PROVIDER=mistral

ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
